{
  "name": "nova-web",
  "private": true,
  "version": "0.46.0",
  "packageManager": "pnpm@9.15.5",
  "pnpm": {
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.8": "5.0.8"
    }
  },
  "type": "module",
  "scripts": {
